{
  "id": "webauthn",
  "name": "Passkeys",
  "version": "1.2.0",
  "description": "Sign in with a passkey or security key instead of a password.",
  "author": {
    "name": "Termix"
  },
  "license": "Apache-2.0",
  "repository": "https://github.com/Termix-SSH/Plugin-WebAuthn",
  "docs": "https://docs.termix.site/plugins/webauthn",
  "video": "https://www.youtube.com/watch?v=u8isRJFMPwE",
  "category": "Access & Security",
  "icon": "Fingerprint",
  "features": [
    "Passkeys and security keys",
    "Counts as a second factor when it checks your PIN or fingerprint",
    "Ask for a security key after your password",
    "More than one passkey, including synced ones"
  ],
  "engine": {
    "termix": ">=26.10.0",
    "api": "^1.2"
  },
  "capabilities": [
    "db:own",
    "network:serve",
    "auth:provide",
    "settings:read-core",
    "ui:surface",
    "db:core-refs"
  ],
  "contributes": {
    "auth": {
      "loginMethods": ["passkey"],
      "secondFactors": ["security-key"]
    },
    "settings": {
      "admin": [
        {
          "key": "passwordlessLogin",
          "type": "boolean",
          "labelKey": "settings.admin.passwordlessLogin.label",
          "descriptionKey": "settings.admin.passwordlessLogin.description",
          "default": true
        }
      ]
    }
  },
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"],
  "desktop": "server"
}
